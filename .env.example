# Copy this file to `.env` and fill in the value to run MyanTone AI locally
# with the real AI model. Without it the app falls back to a basic offline
# rule engine and results will look generic.
#
# On Lovable this key is provisioned automatically. For a local clone, create a
# Lovable AI Gateway key from your Lovable workspace and paste it below.
LOVABLE_API_KEY=
